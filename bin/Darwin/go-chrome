#!/opt/homebrew/bin/bash
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/usr/bin:$HOME/usr/bin-public/$(uname -s):$HOME/usr/bin-public:$PATH"

# Have too many chrome windows?
# This lists chrome windows and lets you pick one and jumps to it.

# I use this as an iterm2 hotkey window.

# Note that this does not handle the case where chrome has multiple
# instances via --no-first-run --user-data-dir=DIRNAME.


if [[ $1 != --no-make-terminal ]]
then
  if [[ -z $TERM ]] || [[ $1 = --make-terminal ]]
  then
    rp="$(realpath "$0")"
    cd
    osascript <<EOF
tell application "Terminal"
    set newWindow to (do script "$rp --no-make-terminal ; exit")
    activate

    -- Wait until the command completes and the shell exits
    repeat while busy of newWindow
        delay 0.1
    end repeat

    close (first window whose selected tab is newWindow) saving no
end tell
EOF
    exit
  fi
fi

# List all window items from Chrome's Window menu
function get_chrome_window_names()
{
  osascript -l JavaScript -e '
    const chrome = Application("Google Chrome");
    if (!chrome.running()) $.exit(1);
    chrome.windows().map(w => w.title()).join("\n");
  '
}

read -r -d '' open_target_chrome_window <<'EOF' || true
function run(argv) {
  const targetName = argv[0];
  const sys = Application("System Events");
  const chrome = Application("Google Chrome");

  chrome.activate();
  const menu = sys.processes.byName("Google Chrome").menuBars[0].menuBarItems.byName("Window").menus[0];
  const item = menu.menuItems.byName(targetName);

  if (item.exists())
    item.click();
}
EOF

if [[ $1 == --list ]] || [[ $1 == -l ]]
then
  get_chrome_window_names | LC_ALL=C sort -f
  exit
fi

FZF=()
FZF+=( --layout=reverse )
FZF+=( --info=inline-right )

# Fuzzy select and click the chosen window name
target_window=$(get_chrome_window_names | LC_ALL=C sort -f | fzf "${FZF[@]}" \
  --prompt="Select Chrome Window > " \
)

if [[ -n "$target_window" ]]
then
  osascript -l JavaScript -e "$open_target_chrome_window" "$target_window"
fi
