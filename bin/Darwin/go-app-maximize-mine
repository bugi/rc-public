#!/usr/bin/env bash
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/usr/bin:$HOME/usr/bin-public/$(uname -s):$HOME/usr/bin-public:$PATH"

cycle-display leftmost
go-app --maximize com.googlecode.iterm2
cycle-display 0s center
go-app --maximize com.googlecode.iterm2
cycle-display 0s rightmost
go-app --maximize com.googlecode.iterm2

cycle-display 0s rightmost

go-app --maximize com.microsoft.Outlook
go-app --maximize org.mozilla.firefox
go-app --maximize com.google.Chrome

cycle-display 0s center
