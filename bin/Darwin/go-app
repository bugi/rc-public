#!/usr/bin/env bash
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/usr/bin:$HOME/usr/bin-public/$(uname -s):$HOME/usr/bin-public:$PATH"

case "$1" in
  (--maximize|--max|max)
    shift
    if [[ $1 == mine ]]
    then
      shift
      exec go-app-maximize-mine "$@"
    else
      exec go-app-maximize "$@"
    fi
    ;;
  (--list|-l|list)
    shift
    exec go-app-list "$@"
    ;;
esac

echo "You'll need to tell me what chromey thing you want." 1>&2
exit 1
